# Öffentliche Domain ohne Schema, z. B. aeneas.test oder verein.example
DOMAIN=aeneas.test

# Keycloak Frontend-URL inkl. Schema (lokal http, Produktion https)
KC_HOSTNAME=http://id.aeneas.test

# PostgreSQL (ein Cluster, mehrere Datenbanken)
POSTGRES_USER=aeneas
POSTGRES_PASSWORD=changeme-postgres

# Keycloak erster Admin — nach dem ersten Start in Keycloak ändern
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=changeme-keycloak

# Portal OIDC (Client-ID portal im Realm aeneas). Secret aus Keycloak → Credentials.
PORTAL_OIDC_CLIENT_ID=portal
PORTAL_OIDC_CLIENT_SECRET=
SESSION_SECRET=changeme-portal-session
# Zammad (eigener Postgres/Redis/Elasticsearch, nicht der Infra-Cluster)
ZAMMAD_POSTGRES_PASS=changeme-zammad
# Elasticsearch Heap, lokal 1g; bei RAM-Druck 512m: ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
# ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

