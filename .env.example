# Öffentliche Domain ohne Schema, z. B. aeneas.test oder verein.example
DOMAIN=aeneas.test

# PostgreSQL (ein Cluster, mehrere Datenbanken)
POSTGRES_USER=aeneas
POSTGRES_PASSWORD=changeme-postgres

# Keycloak erster Admin — nach dem ersten Start in Keycloak ändern
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=changeme-keycloak
