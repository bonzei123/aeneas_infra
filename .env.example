# Kopieren: cp .env.example .env
# .env nicht committen. Platzhalter nur lokal; auf dem Server neue Secrets.

# --- Hosts ---
# Apex ohne Schema. Subdomains: id. www. portal. cav. help. learn. chat. cloud.
DOMAIN=aeneas.test

# Traefik Let’s Encrypt (HTTP-01). Auf dem öffentlichen Host Pflicht.
# Lokal weglassen oder Dummy — Compose warnt sonst, ACME greift nicht.
ACME_EMAIL=

# http lokal / https hinter Traefik-TLS (Zammad http_type + nginx scheme)
PUBLIC_SCHEME=http

# Keycloak Frontend-URL inkl. Schema. Muss zum Browser passen.
KC_HOSTNAME=http://id.aeneas.test

# Portal-Redirect und post_logout. Demo: https://portal.<DOMAIN>
# www. ist nur Alias; Login-URL = dieser Wert.
PORTAL_PUBLIC_URL=http://www.aeneas.test

# Realm-Name (Keycloak + Portal). Default aeneas.
# KEYCLOAK_REALM=aeneas

# --- Traefik-Bindung ---
# Default in compose.yml: 80:80.
# Öffentliche Demo: Ports fest 80 und 443 in compose (TLS-Patch), diese Zeile nicht setzen.
# Hinter anderem Proxy (Port 80 belegt): nur Loopback.
# TRAEFIK_PORTS=127.0.0.1:8080:80

# --- Postgres (Keycloak, Portal, CAV — nicht Zammad) ---
POSTGRES_USER=aeneas
POSTGRES_PASSWORD=changeme-postgres

# --- Keycloak Bootstrap (nur erster Start, dann dauerhaften Admin in master) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=changeme-keycloak

# --- Portal OIDC ---
# Client-ID portal, confidential. Secret aus Keycloak → Credentials.
PORTAL_OIDC_CLIENT_ID=portal
PORTAL_OIDC_CLIENT_SECRET=
SESSION_SECRET=changeme-portal-session

# --- Zammad (eigener Postgres/Redis/Elasticsearch) ---
ZAMMAD_POSTGRES_PASS=changeme-zammad
# Heap. Demo/kleiner Host: 512m. Lokal Default 1g in compose.zammad.yml.
# ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
# Overlay-Secrets erst wenn die Compose-Datei wirklich startet:
# NEXTCLOUD_POSTGRES_PASS=
# FRAPPE_MARIADB_ROOT=

# --- Öffentliche Demo (Referenz, nicht unkommentiert lassen) ---
# DOMAIN=aeneas-solutions.de
# ACME_EMAIL=admin@aeneas-solutions.de
# PUBLIC_SCHEME=https
# KC_HOSTNAME=https://id.aeneas-solutions.de
# PORTAL_PUBLIC_URL=https://portal.aeneas-solutions.de
# ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
# Mail-Passwörter nicht hier — Zammad-Kanal und Keycloak-UI, siehe MAIL.md
